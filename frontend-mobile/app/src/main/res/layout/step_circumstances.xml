<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_step_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header_circumstances"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/label_circ_prompt_multi"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tab_circ_a"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/header_vehicle_a"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tab_circ_b"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/header_vehicle_b"
                android:layout_marginStart="4dp"
                android:alpha="0.3"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/circumstances_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_parked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_parked_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_stopping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_stopping_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_starting_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_starting_off_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_opening_door"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_opening_door_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_leaving_parking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_leaving_parking_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_entering_parking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_entering_parking_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_entering_roundabout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_entering_roundabout_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_circulating_roundabout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_in_roundabout_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_rear_end_same"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_rear_end_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_changing_lanes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_changing_lanes_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_overtaking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_overtaking_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_turning_right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_turning_right_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_turning_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_turning_left_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_reversing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_reversing_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_entering_opposite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_opposite_lane_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_from_right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_from_right_full" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_failed_priority"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/circ_failed_priority_full" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
